<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<!-- Next alarm message -->
	<com.google.android.material.textview.MaterialTextView
		android:id="@+id/tv_next_alarm"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/black"
		android:gravity="center_horizontal"
		android:paddingTop="@dimen/small"
		android:paddingBottom="@dimen/tiny"
		android:textSize="@dimen/tsz_normal"
		android:text=""
		app:layout_constraintStart_toEndOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toTopOf="@id/ll_alarm_groups"
		/>

	<!-- Alarm groups. Scrolls when the open groups take too much space -->
	<androidx.core.widget.NestedScrollView
		android:id="@+id/ll_alarm_groups"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/black"
		app:layout_constrainedHeight="true"
		app:layout_constraintHeight_max="300dp"
		app:layout_constraintStart_toEndOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toBottomOf="@id/tv_next_alarm"
		app:layout_constraintBottom_toTopOf="@id/rv_alarm_list">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="@dimen/normal"
		android:paddingEnd="@dimen/normal">

		<!-- Header with the button to add a new group -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<com.google.android.material.textview.MaterialTextView
				android:id="@+id/tv_alarm_groups_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/alarm_group_title"
				android:textSize="@dimen/tsz_normal"
				android:textStyle="bold"
				/>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/btn_new_alarm_group"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/alarm_group_new"
				/>

		</LinearLayout>

		<!-- One row per group, added in code -->
		<LinearLayout
			android:id="@+id/ll_alarm_group_rows"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			/>

	</LinearLayout>

	</androidx.core.widget.NestedScrollView>

	<!-- Alarm list -->
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rv_alarm_list"
		android:contentDescription="@string/cd_alarm_list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:paddingBottom="@dimen/bottom_nav_height"
		android:clipToPadding="false"
		android:descendantFocusability="blocksDescendants"
		android:scrollbars="vertical"
		app:layout_constraintStart_toEndOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toBottomOf="@id/ll_alarm_groups"
		app:layout_constraintBottom_toBottomOf="parent"
		/>

	<!-- Navigation host -->
	<androidx.fragment.app.FragmentContainerView
		android:id="@+id/options_content"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:name="androidx.navigation.fragment.NavHostFragment"
		app:defaultNavHost="true"
		/>

</androidx.constraintlayout.widget.ConstraintLayout>
